# ─── Frontend environment variables ─────────────────────────────────────────
# Copy this file to .env and fill in the values.

# SecureFlow escrow contract address (deployed via deploy.sh)
VITE_SECUREFLOW_CONTRACT_ADDRESS=0x

# EIP-2771 trusted forwarder address (deployed separately)
VITE_TRUSTED_FORWARDER_ADDRESS=0x

# Backend API (set to your deployed API URL in production)
VITE_API_URL=http://localhost:8787
VITE_API_SECRET=change-me-in-production

# Owner address (used as fallback for admin detection)
VITE_OWNER_ADDRESS=0x
