# ─── Frontend environment variables ─────────────────────────────────────────
# Copy this file to .env and fill in the values.

# Arc Testnet Configuration
# Optional. An override belonging to the other network is ignored with a
# console warning — a stale testnet value here once had the app showing
# mainnet in the UI while every balance came back from testnet.
# VITE_ARC_RPC_URL=
# 5042 = Arc mainnet, 5042002 = Arc testnet. Testnet unless this says 5042.
VITE_ARC_CHAIN_ID=5042002
VITE_ARC_EXPLORER_URL=https://testnet.arcscan.app

# SecureFlow escrow contract address (deployed via deploy.sh)
# The live deployments. These do NOT interchange: 0x6142bf… has no code on
# mainnet at all, so pairing it with chain 5042 yields an empty marketplace
# and no error anywhere.
#   mainnet (5042)     0xbdeb44945979a01584fd7d796a71C707D2F83372
#   testnet (5042002)  0x6142bf4855D4F9dbC1cD8109377d4F4E2AF1ab59
VITE_ATELIER_CONTRACT_ADDRESS=0x6142bf4855D4F9dbC1cD8109377d4F4E2AF1ab59

# Circle USDC on Arc Testnet (official, 6 decimals)
VITE_USDC_TOKEN_CONTRACT=0x3600000000000000000000000000000000000000

# Reown (WalletConnect) Project ID
VITE_REOWN_PROJECT_ID=your_project_id_here

# Backend API (set to your deployed API URL in production)
VITE_API_URL=http://localhost:8787
VITE_API_SECRET=change-me-in-production

# Groq AI Configuration (for milestone generation)
GROQ_API_KEY=your_groq_api_key_here
# llama-3.3-70b-versatile was decommissioned by Groq on 2026-08-16.
GROQ_MODEL=openai/gpt-oss-120b

# Brave Search API (for AI features)
BRAVE_SEARCH_API_KEY=your_brave_api_key_here

# Patron daemon — Autopilot's brain. Left blank, Atelier runs SecureFlow-only
# and the Autopilot surfaces disable themselves rather than erroring.
VITE_AGENT_API_URL=

# Telegram bot handle for the worker front door. Blank hides the card.
# Handle only, no @ and no t.me/ prefix.
VITE_TELEGRAM_BOT=The_Atelierbot

# Google OAuth client id (Web application). Blank disables managed sign-up.
VITE_GOOGLE_CLIENT_ID=

# The Graph — Subgraph Studio endpoint the app reads job and application state
# from. Without it the board falls back to direct RPC reads, which work but are
# slower and cannot answer "who applied" in one call.
VITE_GRAPH_URL=https://api.studio.thegraph.com/query/<id>/atelier/<version>
